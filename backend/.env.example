# 서버
PORT=3000

# JWT — 반드시 안전한 랜덤 문자열로 설정 (python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
JWT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Flask AI 서비스
FLASK_PORT=5001

# SMTP (비밀번호 재설정 메일)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkinAI <your_email@gmail.com>

# 프론트엔드 URL (비밀번호 재설정 링크용)
FRONTEND_URL=https://your-domain.com
